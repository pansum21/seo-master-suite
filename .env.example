# SEOPulse Pro - Configuration
PORT=5050

# Google Gemini API Key (100% Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Ahrefs free Domain Rating endpoint (requires an API v3 key)
# Create a key in Ahrefs account settings → API keys, then set it in the server environment.
AHREFS_API_KEY=your_ahrefs_api_v3_key_here
